# Copy to .env on the node (mode 600). Never commit .env.
NODE_ENV=production
PORT=8480
TZ=America/Toronto
# Public origin. Security-relevant: the ONLY origin accepted for passkeys and mutating requests; its host is the passkey RP ID.
APP_URL=https://note.spboucher.ai
APP_VERSION=2.0.0
# Optional, leave unset: passkey RP ID when it must be a parent domain of the APP_URL host. Changing it invalidates every passkey.
# AUTH_RP_ID=
# Development only (ignored in production): extra accepted origins, comma separated.
# AUTH_EXTRA_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://note:CHANGE_ME@127.0.0.1:5432/note_spboucher
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: contact address sent to Crossref for DOI lookups ("polite pool"). Without it the public pool is used.
# CROSSREF_MAILTO=
DATA_DIR=./data
BACKUP_DIR=./backups
BACKUP_PASSPHRASE=CHANGE_ME_long_random
BACKUP_OFFSITE=
BACKUP_KEEP_DAYS=30
LOG_LEVEL=info
# No access secret lives here: sign-in is by passkey. First passkey: pnpm auth:open-enrollment (docs/security.md).
