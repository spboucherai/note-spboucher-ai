# Copy to .env on the node (mode 600). Never commit .env.
NODE_ENV=production
PORT=8480
APP_URL=https://note.spboucher.ai
DATABASE_URL=postgres://note:CHANGE_ME@127.0.0.1:5432/note_spboucher
# Access gate (pnpm access:password / pnpm access:rotate-key write these; never commit real values)
ACCESS_KEY=CHANGE_ME_32_bytes_base64url
ACCESS_PASSWORD_HASH=b64:CHANGE_ME_base64url_of_argon2id_phc
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DATA_DIR=./data
BACKUP_AGE_RECIPIENT=age1...
BACKUP_DIR=./backups
LOG_LEVEL=info
